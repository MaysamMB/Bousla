        }
      },
      {
        "id": "b",
        "text": {
          "ar": "لا يمكن تمثيلها في قاعدة بيانات علائقية",
          "en": "It cannot be represented in a relational database"
        }
      },
      {
        "id": "c",
        "text": {
          "ar": "بعمود واحد يخزّن قائمة من المعرّفات",
          "en": "With one column storing a list of IDs"
        }
      },
      {
        "id": "d",
        "text": {
          "ar": "بدمج الجدولين في جدول واحد",
          "en": "By merging both tables into one"
        }
      }
    ],
    "provenance": {
      "source": "ai_draft",
