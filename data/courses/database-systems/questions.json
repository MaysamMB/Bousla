          "en": "One-to-one"
        }
      },
      {
        "id": "c",
        "text": {
          "ar": "متعدد إلى متعدد (Many-to-Many)",
          "en": "Many-to-many"
        }
      },
      {
        "id": "d",
        "text": {
          "ar": "واحد إلى متعدد (One-to-Many)",
          "en": "One-to-many"
        }
      }
    ],
    "provenance": {
      "source": "ai_draft",
      "status": "pending_review",
      "reviewed_by": null
    },
    "synthetic": false
  },
  {
    "id": "db_er_002",
    "concept_ids": [
      "er_modeling",
      "foreign_key"
    ],
    "type": "multiple_choice",
    "difficulty": "intermediate",
    "prompt": {
      "ar": "كيف تُنفَّذ علاقة متعدد إلى متعدد عادةً في الجداول العلائقية؟",
      "en": "How is a many-to-many relationship usually implemented in relational tables?"
    },
    "options": [
      {
        "id": "a",
        "text": {
          "ar": "بجدول ربط منفصل يحتوي مفتاحين خارجيين",
