  {
    "id": "db_fk_002",
    "concept_ids": [
      "foreign_key"
    ],
    "type": "multiple_choice",
    "difficulty": "intermediate",
    "prompt": {
      "ar": "في الجدول Enrollment(student_id, course_id) يشير student_id إلى الجدول Student. ماذا يحدث عند إدخال تسجيل بقيمة student_id غير موجودة في Student مع تفعيل القيد؟",
      "en": "In Enrollment(student_id, course_id), student_id references Student. With the constraint enforced, what happens when inserting an enrollment whose student_id does not exist in Student?"
    },
    "options": [
      {
        "id": "a",
        "text": {
          "ar": "يُقبل الإدخال دون أي تحقق",
          "en": "The insert is accepted without any check"
        }
      },
      {
        "id": "b",
        "text": {
          "ar": "يُنشأ الطالب تلقائياً",
          "en": "The student is created automatically"
        }
      },
      {
        "id": "c",
        "text": {
          "ar": "يُرفض الإدخال للحفاظ على سلامة المراجع",
          "en": "The insert is rejected to preserve referential integrity"
        }
      },
      {
        "id": "d",
        "text": {
          "ar": "يُحذف الجدول Student",
          "en": "The Student table is deleted"
        }
      }
    ],
    "provenance": {
      "source": "ai_draft",
      "status": "pending_review",
      "reviewed_by": null
    },
    "synthetic": false
  },
  {
