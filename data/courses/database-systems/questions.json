  {
    "id": "db_fd_001",
    "concept_ids": [
      "functional_dependency"
    ],
    "type": "multiple_choice",
    "difficulty": "basic",
    "prompt": {
      "ar": "ماذا تعني الاعتمادية الوظيفية A → B؟",
      "en": "What does the functional dependency A → B mean?"
    },
    "options": [
      {
        "id": "a",
        "text": {
          "ar": "كل قيمة لـ B تحدد قيمة واحدة فقط لـ A",
          "en": "Each value of B determines exactly one value of A"
        }
      },
      {
        "id": "b",
        "text": {
          "ar": "كل قيمة لـ A تحدد قيمة واحدة فقط لـ B",
          "en": "Each value of A determines exactly one value of B"
        }
      },
      {
        "id": "c",
        "text": {
          "ar": "قيم A وB متساوية دائماً",
          "en": "A and B always have equal values"
        }
      },
      {
        "id": "d",
        "text": {
          "ar": "A مفتاح خارجي يشير إلى B",
          "en": "A is a foreign key referencing B"
        }
      }
    ],
    "provenance": {
      "source": "ai_draft",
      "status": "pending_review",
      "reviewed_by": null
    },
    "synthetic": false
  },
