rules_version = '2';

// Bousla Firestore security rules. See docs/architecture.md §6.
//
// Roles:
// - Instructor: signed in with email/password (not anonymous) AND listed in
//   instructors/{uid}. Owns the courses and sessions whose owner_id is their
//   UID. The list is edited only in the Firebase console (no app can write
//   it), so creating an account is not enough to become an instructor.
// - Student: signed in anonymously. The anonymous UID identifies a
//   participant within a session only (architecture §10).
//
// Hiding things in the UI is not authorization: these rules are the access
// control, and firebase/test/rules.test.mjs checks them on the emulator.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isInstructor() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/instructors/$(request.auth.uid));
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId));
    }

    function ownsCourse(courseId) {
      return isInstructor()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && courseDoc(courseId).data.owner_id == request.auth.uid;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function ownsSession(sessionId) {
      return isInstructor()
        && sessionDoc(sessionId).data.owner_id == request.auth.uid;
    }

    // A session title: {ar, en}, both text, at most 120 characters each.
    function validTitle(t) {
      return t is map && t.keys().hasOnly(['ar', 'en'])
        && t.ar is string && t.en is string
        && t.ar.size() <= 120 && t.en.size() <= 120;
    }

    function approved() {
      return resource.data.provenance.status == 'approved';
    }

    // ------------------------------------------------------------ instructors
    // Approved instructors, one document per UID. A signed-in user may check
    // their own entry (the app shows "waiting for approval" otherwise).
    // Nobody may list or write it from a client: entries are added in the
    // Firebase console, where these rules do not apply.
    match /instructors/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------------------------------------------------------------- courses
    match /courses/{courseId} {
      // Course names are not sensitive; students need them in a session.
      allow get: if signedIn();
      allow list: if isInstructor()
        && resource.data.owner_id == request.auth.uid;
      allow create: if isInstructor()
        && request.resource.data.owner_id == request.auth.uid;
      allow update: if ownsCourse(courseId)
        && request.resource.data.owner_id == request.auth.uid;
      allow delete: if ownsCourse(courseId);

      // Concepts, questions (one document per version) and resources.
      // Students may read approved items only, one at a time (no listing).
      match /concepts/{itemId} {
        allow get: if ownsCourse(courseId) || (signedIn() && approved());
        allow list, write: if ownsCourse(courseId);
      }
      match /questions/{itemId} {
        allow get: if ownsCourse(courseId) || (signedIn() && approved());
        allow list, write: if ownsCourse(courseId);
      }
      match /resources/{itemId} {
        allow get: if ownsCourse(courseId) || (signedIn() && approved());
        allow list, write: if ownsCourse(courseId);
      }

      // Answer keys: course owner only. Never readable by students.
      match /answer_keys/{keyId} {
        allow read, write: if ownsCourse(courseId);
      }

      match /materials/{materialId} {
        allow read, write: if ownsCourse(courseId);
        match /sections/{sectionId} {
          allow read, write: if ownsCourse(courseId);
        }
      }
    }

    // --------------------------------------------------------------- sessions
    // The document ID is the join code. Anyone signed in who knows the code
    // can read the session; nobody but the owner can list sessions, so codes
    // cannot be enumerated.
    match /sessions/{sessionId} {
      allow get: if signedIn();
      allow list: if isInstructor()
        && resource.data.owner_id == request.auth.uid;
      allow create: if isInstructor()
        && request.resource.data.owner_id == request.auth.uid
        && ownsCourse(request.resource.data.course_id)
        && request.resource.data.status == 'open'
        && request.resource.data.feedback_released == false;
      // The owner can only close the session, release feedback and rename
      // it (a short title in Arabic and English, shown in past sessions).
      allow update: if ownsSession(sessionId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'feedback_released', 'closed_at', 'title'])
        && request.resource.data.status in ['open', 'closed']
        && (!('title' in request.resource.data)
            || validTitle(request.resource.data.title));
      allow delete: if false;

      match /participants/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && sessionDoc(sessionId).data.status == 'open';
        allow get: if signedIn() && request.auth.uid == uid;
        allow read: if ownsSession(sessionId);
        allow update, delete: if false;
      }

      // One document per participant per question version:
      // {participantUid}_{questionId}_v{version}. Written once, only by that
      // participant, only while the session is open, only for a question
      // version that belongs to the session. Never updated or deleted, so a
      // second answer is refused.
      match /responses/{responseId} {
        allow create: if signedIn()
          && request.resource.data.participant_id == request.auth.uid
          && responseId == request.auth.uid + '_'
               + request.resource.data.question_id + '_v'
               + string(request.resource.data.question_version)
          && sessionDoc(sessionId).data.status == 'open'
          && (request.resource.data.question_id + '_v'
               + string(request.resource.data.question_version))
             in sessionDoc(sessionId).data.question_keys
          && request.resource.data.display_language in ['ar', 'en']
          && request.resource.data.selected_option_id is string
          && request.resource.data.keys().hasOnly([
               'participant_id', 'question_id', 'question_version',
               'selected_option_id', 'display_language', 'free_text',
               'submitted_at'])
          && request.resource.data.submitted_at == request.time;
        // A student can check whether their own answer exists (decided by
        // the document ID, so it also works for a missing document); the
        // owner reads all.
        allow get: if signedIn()
          && responseId.matches('^' + request.auth.uid + '_.*');
        allow read: if ownsSession(sessionId);
        allow update, delete: if false;
      }

      // Engine output, written by the instructor app (Option A).
      match /aggregates/{docId} {
        allow read, write: if ownsSession(sessionId);
      }

      // Personal feedback: that student only, and only once released.
      match /feedback/{uid} {
        allow read: if ownsSession(sessionId)
          || (signedIn() && request.auth.uid == uid
              && sessionDoc(sessionId).data.feedback_released == true);
        allow write: if ownsSession(sessionId);
      }
    }

    // ---------------------------------------------------------- profiles
    // Optional personal learning profile (architecture §10). A student who
    // agrees links their anonymous account to Google, keeping the same UID,
    // and keeps their own session results. Only that student, signed in
    // (not anonymous), can read, add to or delete it. No rule here gives
    // instructors any access, and profiles cannot be listed.
    function isOwnerSignedIn(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A student whose Google account already has a profile from another
    // browser: before signing in to it, this browser (still anonymous)
    // writes a handover for the session it has feedback in. The id is
    // random and known only to this browser. The profile can then add that
    // session for 10 minutes. Nobody reads handovers; only these rules do.
    match /profile_handovers/{id} {
      allow create: if signedIn()
        && request.resource.data.keys()
             .hasOnly(['session_id', 'from_uid', 'created_at'])
        && request.resource.data.from_uid == request.auth.uid
        && request.resource.data.created_at == request.time
        && request.resource.data.session_id is string
        && sessionDoc(request.resource.data.session_id).data.feedback_released == true
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)/feedback/$(request.auth.uid));
    }

    // ------------------------------------------------- private follow-ups
    // "Test my understanding again": one student's own private
    // reassessment after a session. Its questions are the new ones the
    // instructor app reserved for this student when it published feedback
    // (reassessment_question_keys in their feedback document); students
    // never list the question bank. No instructor creates, reads or grades
    // any of it: no rule below gives instructors access. Without a server
    // (Spark plan), each grade is checked here against the answer key,
    // which the browser never reads.

    function followUpDoc(attemptId) {
      return get(/databases/$(database)/documents/followups/$(attemptId));
    }

    function ownsFollowUp(attemptId) {
      return signedIn() && followUpDoc(attemptId).data.owner_id == request.auth.uid;
    }

    function myFeedback(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)/feedback/$(request.auth.uid));
    }

    // The attempt: {uid}_{sessionId}, so there is one per student and
    // session (a second create is refused). The student is the one the
    // feedback belongs to; its concepts and questions must all be among the
    // ones the instructor app stored in that feedback.
    match /followups/{attemptId} {
      allow get: if signedIn()
        && attemptId.matches('^' + request.auth.uid + '_.+')
        && (resource == null || resource.data.owner_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner_id', 'session_id',
             'course_id', 'concept_ids', 'question_keys', 'language',
             'status', 'created_at'])
        && request.resource.data.owner_id == request.auth.uid
        && request.resource.data.session_id is string
        && attemptId == request.auth.uid + '_' + request.resource.data.session_id
        && sessionDoc(request.resource.data.session_id).data.course_id
             == request.resource.data.course_id
        && sessionDoc(request.resource.data.session_id).data.feedback_released == true
        && request.resource.data.concept_ids is list
        && request.resource.data.concept_ids.size() >= 1
        && request.resource.data.concept_ids.size() <= 5
        && myFeedback(request.resource.data.session_id)
             .data.review_concept_ids.hasAll(request.resource.data.concept_ids)
        && request.resource.data.question_keys is list
        && request.resource.data.question_keys.size() >= 1
        && request.resource.data.question_keys.size() <= 10
        && myFeedback(request.resource.data.session_id)
             .data.reassessment_question_keys.hasAll(request.resource.data.question_keys)
        && request.resource.data.language in ['ar', 'en']
        && request.resource.data.status == 'in_progress'
        && request.resource.data.created_at == request.time;
      // Finishing, once: nothing else changes.
      allow update: if signedIn()
        && resource.data.owner_id == request.auth.uid
        && resource.data.status == 'in_progress'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'finished_at'])
        && request.resource.data.status == 'finished'
        && request.resource.data.finished_at == request.time;
      allow list, delete: if false;

      // One answer per question of the attempt, while it is in progress.
      // Never changed.
      match /answers/{key} {
        allow create: if ownsFollowUp(attemptId)
          && followUpDoc(attemptId).data.status == 'in_progress'
          && request.resource.data.keys().hasOnly(['question_id',
               'question_version', 'selected_option_id', 'answered_at'])
          && key == request.resource.data.question_id + '_v'
               + string(request.resource.data.question_version)
          && key in followUpDoc(attemptId).data.question_keys
          && request.resource.data.selected_option_id is string
          && request.resource.data.answered_at == request.time;
        allow read: if ownsFollowUp(attemptId);
        allow update, delete: if false;
      }

      // The grade of a stored answer: accepted only when `correct` is what
      // the answer key says and `concept_ids` are the question's. get()
      // reads the answer as stored before this write, so an answer and its
      // grade cannot be tried together in one batch. Never changed.
      match /grades/{key} {
        allow create: if ownsFollowUp(attemptId)
          && key in followUpDoc(attemptId).data.question_keys
          && exists(/databases/$(database)/documents/followups/$(attemptId)/answers/$(key))
          && request.resource.data.keys()
               .hasOnly(['correct', 'concept_ids', 'graded_at'])
          && request.resource.data.graded_at == request.time
          && request.resource.data.correct is bool
          && request.resource.data.correct
             == (get(/databases/$(database)/documents/courses/$(followUpDoc(attemptId).data.course_id)/answer_keys/$(key)).data.correct_option_id
                 == get(/databases/$(database)/documents/followups/$(attemptId)/answers/$(key)).data.selected_option_id)
          && get(/databases/$(database)/documents/courses/$(followUpDoc(attemptId).data.course_id)/questions/$(key)).data.provenance.status == 'approved'
          && request.resource.data.concept_ids
             == get(/databases/$(database)/documents/courses/$(followUpDoc(attemptId).data.course_id)/questions/$(key)).data.concept_ids;
        allow read: if ownsFollowUp(attemptId);
        allow update, delete: if false;
      }
    }

    function handoverDoc(id) {
      return get(/databases/$(database)/documents/profile_handovers/$(id));
    }

    function handoverAllows(code, id) {
      return id is string && id.size() > 0
        && exists(/databases/$(database)/documents/profile_handovers/$(id))
        && handoverDoc(id).data.session_id == code
        && handoverDoc(id).data.created_at > request.time - duration.value(10, 'm')
        && exists(/databases/$(database)/documents/sessions/$(code)/feedback/$(handoverDoc(id).data.from_uid));
    }

    // A name and a preset picture the student may set for their own
    // profile (seen by them only).
    function validProfileInfo(d) {
      return (!('display_name' in d)
          || (d.display_name is string && d.display_name.size() <= 40))
        && (!('avatar' in d)
          || (d.avatar is int && d.avatar >= 0 && d.avatar < 12));
    }

    match /profiles/{uid} {
      allow get, delete: if isOwnerSignedIn(uid);
      // The consent record (the version of the text agreed to, and when),
      // plus an optional name and picture.
      allow create: if isOwnerSignedIn(uid)
        && request.resource.data.keys().hasOnly(['consent_version',
             'consented_at', 'created_at', 'display_name', 'avatar'])
        && request.resource.data.consent_version is int
        && request.resource.data.consented_at == request.time
        && validProfileInfo(request.resource.data);
      // Agreeing again (new time), or a new name or picture with the
      // consent record left exactly as it was.
      allow update: if isOwnerSignedIn(uid)
        && request.resource.data.keys().hasOnly(['consent_version',
             'consented_at', 'created_at', 'display_name', 'avatar'])
        && request.resource.data.consent_version is int
        && (request.resource.data.consented_at == request.time
          || (request.resource.data.consent_version == resource.data.consent_version
            && request.resource.data.consented_at == resource.data.consented_at))
        && validProfileInfo(request.resource.data);

      // One document per session, copied from the student's own released
      // feedback: only a session whose feedback was released and where this
      // student really has feedback (under this UID, or under the browser
      // that handed it over), so nothing can be invented. Not edited
      // afterwards; the student may remove it.
      match /sessions/{code} {
        allow get, list, delete: if isOwnerSignedIn(uid);
        allow create: if isOwnerSignedIn(uid)
          && exists(/databases/$(database)/documents/profiles/$(uid))
          && sessionDoc(code).data.feedback_released == true
          && (exists(/databases/$(database)/documents/sessions/$(code)/feedback/$(uid))
              || handoverAllows(code, request.resource.data.get('handover_id', '')))
          && request.resource.data.keys()
               .hasOnly(['course_id', 'title', 'concepts', 'added_at', 'handover_id'])
          && request.resource.data.course_id == sessionDoc(code).data.course_id
          && request.resource.data.concepts is list
          && request.resource.data.added_at == request.time;
        allow update: if false;
      }
    }
  }
}
